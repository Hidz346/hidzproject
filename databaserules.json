{
  "rules": {
    ".read": false,
    ".write": false,
    "hidz_access_db": {
      ".read": false,
      ".write": false
    },
    "hidz_sessions": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        "$deviceId": {
          ".validate": "(newData.hasChildren([\"loginAt\"]) && newData.child(\"loginAt\").isNumber()) || !newData.exists()"
        }
      }
    },
    "hidz_banned": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "hidz_blocked_devices": {
      ".read": "auth != null && auth.token.admin === true",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true",
        "$deviceId": {
          ".write": "auth != null && auth.uid === $userId && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren([\"blockedAt\"]) && newData.child(\"blockedAt\").isNumber() && (!newData.hasChild(\"reason\") || newData.child(\"reason\").isString())"
        }
      }
    },
    "hidz_maintenance_mode": {
      ".read": true,
      ".write": false
    },
    "hidz_force_relogin": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".validate": "newData.isNumber() || !newData.exists()"
    },
    "hidz_file_ver": {
      ".read": true,
      ".write": false,
      ".validate": "newData.isString()"
    },
    "hidz_delete_all_trigger": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".validate": "newData.isNumber() || !newData.exists()"
    },
    "hidz_admin_login_attempts": {
      ".read": false,
      ".write": false
    },
    "hidz_security_alerts": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "hidz_announcement_promo": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "hidz_announcement_feed": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "$annId": {
        ".validate": "newData.hasChildren([\"title\",\"content\"]) && newData.child(\"title\").isString() && newData.child(\"content\").isString()"
      }
    },
    "hidz_counseling_meta": {
      ".read": "auth != null && auth.token.admin === true",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)"
      }
    },
    "hidz_counseling_messages": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)"
      }
    },
    "hidz_counseling_typing": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)"
      }
    },
    "hidz_user_photos": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || $userId === \"admin_hidz_protected\" || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".validate": "newData.isString() || !newData.exists()"
      }
    },
    "hidz_presence": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)"
      }
    },
    "hidz_notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        "$notifId": {
          ".write": "auth != null && auth.uid === $userId && !newData.exists()",
          "shown": {
            ".write": "auth != null && auth.uid === $userId && data.parent().exists()",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
          }
        }
      }
    },
    "hidz_push_subs": {
      ".read": false,
      ".write": false
    },
    "hidz_last_country": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $userId || auth.token.admin === true)"
      }
    },
    "hidz_security_events": {
      ".read": false,
      ".write": false
    },
    "hidz_security_ip_blocks": {
      ".read": false,
      ".write": false
    },
    "hidz_security_csp_reports": {
      ".read": false,
      ".write": false
    },
    "hidz_login_rate_limit": {
      ".read": false,
      ".write": false
    },
    "hidz_admin_rate_limit": {
      ".read": false,
      ".write": false
    },
    "hidz_security_rate_limit": {
      ".read": false,
      ".write": false
    },
    "hidz_vip_rate_limit": {
      ".read": false,
      ".write": false
    },
    "hidz_vip_plans": {
      ".read": false,
      ".write": false
    },
    "hidz_vip_orders": {
      ".read": false,
      ".write": false
    },
    "hidz_vouchers": {
      ".read": false,
      ".write": false
    },
    "hidz_voucher_history": {
      ".read": false,
      ".write": false
    }
  }
}