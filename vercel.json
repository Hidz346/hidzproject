{
  "rewrites": [
    {
      "source": "/api/vip/plans",
      "destination": "/api/check-session?vipAction=plans"
    },
    {
      "source": "/api/vip/voucher-check",
      "destination": "/api/check-session?vipAction=voucher-check"
    },
    {
      "source": "/api/vip/order-create",
      "destination": "/api/check-session?vipAction=order-create"
    },
    {
      "source": "/api/vip/order-status",
      "destination": "/api/check-session?vipAction=order-status"
    },
    {
      "source": "/api/vip/order-cancel",
      "destination": "/api/check-session?vipAction=order-cancel"
    },
    {
      "source": "/api/vip/transactions",
      "destination": "/api/check-session?vipAction=transactions"
    },
    {
      "source": "/api/vip/webhook",
      "destination": "/api/check-session?vipAction=webhook"
    },
    {
      "source": "/api/chat/send",
      "destination": "/api/check-session?vipAction=chat-send"
    },
    {
      "source": "/api/chat/delete",
      "destination": "/api/check-session?vipAction=chat-delete"
    },
    {
      "source": "/api/chat/members",
      "destination": "/api/check-session?vipAction=chat-members"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://accounts.google.com/gsi/client https://www.gstatic.com/firebasejs/ https://cdnjs.cloudflare.com/ajax/libs/firebase/ https://*.firebasedatabase.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://challenges.cloudflare.com https: about:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/security-csp-report"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ],
  "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && npm install --no-fund --no-audit",
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && ./node_modules/.bin/next build"
}
